# FastAPI backend local defaults
# Marker must be installed in the active Python environment.

FRONTEND_ORIGIN=http://localhost:3000
MARKER_COMMAND=marker_single
# Subprocess safety limit for Marker, not an HTTP request timeout.
MARKER_TIMEOUT_SECONDS=3600
# Local background conversion workers. Keep at 1 on most developer laptops.
CONVERSION_CONCURRENCY=1
# Local upload safety limit for PDFs.
MAX_UPLOAD_SIZE_MB=100
